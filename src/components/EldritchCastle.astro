---
// The full-screen illustration; everything is painted by src/scripts/eldritch-castle.ts
---

<figure class="eldritch">
	<canvas
		id="eldritch-castle"
		role="img"
		aria-label="A black gothic castle on a crag, backlit by a pale moon through torn clouds, its towers strangled and split open by wet, slow-moving tentacles"
	></canvas>
</figure>

<script>
	import { mountEldritchCastle } from "../scripts/eldritch-castle";

	mountEldritchCastle(document.getElementById("eldritch-castle") as HTMLCanvasElement);
</script>

<style>
	.eldritch {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		/* The tallest the viewport gets, so phones' toolbars sliding away never resize the scene */
		height: 100vh;
		height: 100lvh;
		margin: 0;
		background: #040404;
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
