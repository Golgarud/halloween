---
// The full-screen illustration; everything is painted by src/scripts/eldritch-castle.ts, from
// textures baked at build time (src/assets/scene/, see scripts/bake-scene.ts)
const textures = Object.values(import.meta.glob<string>("../assets/scene/*.webp", { eager: true, query: "?url", import: "default" }));
---

{/* Fetched while the page is still being read, before the script asks for them */}
{textures.map((url) => <link rel="preload" as="image" href={url} type="image/webp" fetchpriority="high" />)}

<figure class="eldritch">
	<canvas
		id="eldritch-castle"
		role="img"
		aria-label="A black gothic castle on a crag, backlit by a pale moon through torn clouds, its towers strangled and split open by wet, slow-moving tentacles"
	></canvas>
</figure>

<script>
	import { mountEldritchCastle } from "../scripts/eldritch-castle";

	mountEldritchCastle(document.getElementById("eldritch-castle") as HTMLCanvasElement).catch((error) => {
		// Without its textures the scene stays as its moonlit backdrop
		console.error(error);
	});
</script>

<style>
	.eldritch {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		/* The tallest the viewport gets, so phones' toolbars sliding away never resize the scene */
		height: 100vh;
		height: 100lvh;
		margin: 0;
		/* Until the scene is painted: its night sky and the moon's glow, roughly where they will be */
		background:
			radial-gradient(circle at 57% 29%, rgba(214, 208, 180, 0.34), rgba(110, 108, 88, 0.12) 20vmax, transparent 44vmax),
			linear-gradient(#030304, #0a0b0a 35%, #191a14 70%, #1c1c16);
	}

	canvas {
		display: block;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: opacity 1.2s ease-out;
	}

	canvas[data-ready] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		canvas {
			transition: none;
		}
	}
</style>
